    def run_then_refresh(self, args, timeout, ok=None):
        def done(result):
            status, _out, err = result
            if status != 0:
                self.report(status, err)
            elif ok:
                ok()
            self.refresh()
        self.background(lambda: run_raw(args, timeout), done)

    def set_icon(self, name, icon):
        self.run_then_refresh(["icon", name] + ([icon] if icon else []) + ["--json"], 30)

    def save_note(self, name, text):
        text = text.strip()
        self.settings.set_focus(None)
        self.run_then_refresh(["note", name] + ([text] if text else []) + ["--json"], 30,
                              ok=lambda: self.note_drafts.pop(name, None))

    def prompt_add_account(self):
        pressed, _, name = self.alert(
            "Add a Claude account",
            "Pick a short name for it (letters, digits, . _ -). Terminal opens with the official Claude login; "
            "sign in there with the new account.",
            ["Continue", "Cancel"], entry="e.g. work")
        if pressed != 0:
            return
        name = name.strip()
        if not valid_name(name):
            self.show('"%s" is not a valid account name: use letters, digits, . _ - and start with a letter '
                      "or digit." % name)
            return
        # An interactive login shell, so PATH (and the real claude binary
        # that `hotseat add` looks for) is the one the user's terminals see.
        line = "%s add %s; echo; echo 'Done. You can close this window.'; exec bash" % (
            shlex.quote(HOTSEAT), shlex.quote(name))
        try:
            subprocess.Popen(["gnome-terminal", "--title=Hotseat: add " + name, "--", "bash", "-ilc", line])
        except OSError:
            try:
                subprocess.Popen(["x-terminal-emulator", "-e", "bash", "-ilc", line])
            except OSError as e:
                self.show("Could not open a terminal: %s. Run in one: hotseat add %s" % (e.strerror, name))

    def set_up_desktop(self, name):
        who = self.label_of(name)
        pressed, _, _ = self.alert(
            "Set up Claude Desktop for %s?" % who,
            "Claude Desktop quits if it is running and reopens with an empty profile for this account. Sign in "
            "there with %s. Your current Desktop data is kept for its own account." % who,
            ["Set Up", "Cancel"])
        if pressed == 0:
            # Shown as a switch: quitting Desktop can take 20 s, and the
            # icon and cards should say something is happening meanwhile.
            self.start_switch(name, ["desktop", "add", name, "--yes"], 120)

    def confirm_remove(self, name):
        pressed, _, _ = self.alert(
            "Remove %s?" % self.label_of(name),
            "Hotseat signs this account out (claude auth logout) and moves its config dir and Claude Desktop "
            "profile into a Hotseat backup; nothing is deleted. Close any terminal using it first. Your shared "
            "work (projects, history) stays.",
            ["Remove", "Cancel"], destructive=True)
        if pressed != 0:
            return

        def done(result):
            status, out, err = result
            # The account can be gone while Claude Code failed to sign it
            # out; the result says so, the exit code does not.
            problem = error_text(status, err) if status != 0 else removal_problem(name, out)
            if problem:
                self.show(problem)
            self.refresh()
        self.background(lambda: run_raw(["remove", name, "--yes", "--json"], 60), done)

    def set_launch_at_login(self, on):
        try:
            if on:
                os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
                with open(AUTOSTART, "w") as f:
                    f.write(autostart_entry(SELF))
            elif os.path.exists(AUTOSTART):
                os.remove(AUTOSTART)
        except OSError as e:
            self.show("Launch at Login: " + (e.strerror or str(e)))
            # The switch must show what is on disk, not what was asked for.
            if self.settings:
                GLib.idle_add(lambda: self.fill_settings() and False)

    def set_ask_before_restart(self, ask):
        self.prefs["skipDesktopConfirm"] = not ask
        try:
            save_prefs(self.prefs)
        except OSError as e:
            self.show("Could not save preferences: " + (e.strerror or str(e)))

    # ----- Setup (SetupView.swift) -----

    def reload_setup(self, then=None):
        def work():
            v = run_raw(["version", "--json"], 15)
            s = run_raw(["setup", "status", "--json"], 30)
            return v, s

        def done(result):
            (vs, vout, verr), (ss, sout, _serr) = result
            self.setup_load_error = None
            self.setup_version = (parse_object(vout) or {}).get("version") if vs == 0 else None
            if vs != 0:
                self.setup_load_error = error_text(vs, verr)
            self.setup_status = parse_object(sout) if ss == 0 else None
            self.cli_version = self.setup_version
            if self.setup:
                self.fill_setup()
            if then:
                then()
        failed = lambda e: ((None, "", "Hotseat menu: %s" % e),) * 2  # noqa: E731
        self.background(work, done, failed)

    def steps(self):
        return setup_steps(self.setup_status, self.setup_version)

    def open_setup_if_needed(self):
        """Opens Setup by itself once per version while a step is left."""
        pending = any(not s[2] for s in self.steps())
        version = self.setup_version or "dev"
        if pending and self.prefs.get("setupShownForVersion") != version:
            self.prefs["setupShownForVersion"] = version
            try:
                save_prefs(self.prefs)
            except OSError:
                pass
            self.open_setup()

    def open_setup(self):
        if self.setup is None:
            win = Gtk.Window(title="Hotseat Setup")
            win.set_default_size(560, 520)
            win.set_resizable(False)
            win.set_position(Gtk.WindowPosition.CENTER)
            win.connect("destroy", lambda *_: setattr(self, "setup", None))
            self.setup = win
            self.fill_setup()
        self.setup.present()
        self.reload_setup()

    def fill_setup(self):
        win = self.setup
        old = win.get_child()
        if old:
            win.remove(old)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_border_width(20)
        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        head.pack_start(label("Set up Hotseat", "hs-title"), False, False, 0)
        head.pack_start(label("Each step says what it changes. Nothing runs until you click Run.",
                              "hs-secondary"), False, False, 0)
        box.pack_start(head, False, False, 0)
        if self.setup_load_error:
            box.pack_start(label("⚠ " + self.setup_load_error, "hs-warn", wrap=True, chars=70), False, False, 0)
        steps = self.steps()
        cli_ready = bool(steps and steps[0][2])
        desktop_absent = (self.setup_status or {}).get("desktop", "absent") == "absent"
        rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for sid, title, done, detail, commands in steps:
            row = Gtk.Box(spacing=12)
            row.get_style_context().add_class("hs-step")
            mark = label("✔" if done else "○", "hs-done" if done else "hs-todo")
            mark.set_valign(Gtk.Align.START)
            row.pack_start(mark, False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            text.pack_start(label(title, "hs-step-title"), False, False, 0)
            text.pack_start(label(detail, "hs-secondary", wrap=True, chars=56), False, False, 0)
            if sid in self.setup_errors:
                text.pack_start(label(self.setup_errors[sid], "hs-warn", wrap=True, chars=56, selectable=True),
                                False, False, 0)
            row.pack_start(text, True, True, 0)
            if self.setup_running == sid:
                sp = Gtk.Spinner()
                sp.start()
                sp.set_valign(Gtk.Align.START)
                row.pack_end(sp, False, False, 0)
            elif not done:
                # Later steps write the CLI's path into settings.json and the
                # shim, so it must be installed for good before they run.
                run = Gtk.Button(label="Run")
                run.set_valign(Gtk.Align.START)
                run.set_sensitive(self.setup_running is None and commands is not None
                                  and (sid == "cli" or cli_ready)
                                  and not (sid == "desktop" and desktop_absent))
                run.connect("clicked", lambda _b, s=sid, c=commands: self.run_setup_step(s, c))
                row.pack_end(run, False, False, 0)
            rows.pack_start(row, False, False, 0)
        box.pack_start(rows, True, True, 0)
        foot = Gtk.Box()
        again = Gtk.Button(label="Check Again")
        again.set_sensitive(self.setup_running is None)
        again.connect("clicked", lambda *_: self.reload_setup())
        foot.pack_start(again, False, False, 0)
        done_btn = Gtk.Button(label="Done")
        done_btn.get_style_context().add_class("suggested-action")
        done_btn.connect("clicked", lambda *_: self.setup.close())
        foot.pack_end(done_btn, False, False, 0)
        box.pack_start(foot, False, False, 0)
        win.add(box)
        box.show_all()

    def run_setup_step(self, sid, commands):
        if self.setup_running is not None or not commands:
            return
        self.setup_running = sid
        self.setup_errors.pop(sid, None)
        self.fill_setup()

        def work():
            for args in commands:
                status, _out, err = run_raw(args, 120)
                if status != 0:
                    return error_text(status, err)
            return None

        def done(problem):
            if problem:
                self.setup_errors[sid] = problem
            self.setup_running = None
            self.reload_setup()
            self.refresh()
        self.background(work, done, lambda e: "Hotseat menu: %s" % e)


