        page.set_border_width(12)
        rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        for a in (self.snapshot or {}).get("accounts", []):
            rows.pack_start(self.settings_row(a), False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(rows)
        page.pack_start(scroll, True, True, 0)
        foot = Gtk.Box(spacing=8)
        add = Gtk.Button(label="＋ Add Account…")
        add.connect("clicked", lambda *_: self.prompt_add_account())
        foot.pack_start(add, False, False, 0)
        if self.error:
            foot.pack_end(label("⚠ " + self.error, "hs-warn", wrap=True, chars=50), False, False, 0)
        page.pack_start(foot, False, False, 0)
