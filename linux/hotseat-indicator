    def remove_blocker(self, a):
        if a.get("configDir") == os.path.join(HOME, ".claude"):
            return "The default account holds every account's shared work data"
        if a.get("current"):
            return "Switch the CLI to another account first"
        if a.get("desktop") == "active":
            return "Switch Claude Desktop to another account first"
        return None

    def desktop_text(self, a):
        p = a.get("desktopProblem")
        if p:
            return "Set up — switch to it and sign in in Claude Desktop" if p == "not logged in yet" else p
        return {"active": "In use", "parked": "Ready"}.get(a.get("desktop"), "Not set up")

    def general_settings(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        page.set_border_width(12)
        frame = Gtk.ListBox()
        frame.set_selection_mode(Gtk.SelectionMode.NONE)
        frame.get_style_context().add_class("hs-row")

        def form_row(text, widget):
            r = Gtk.Box(spacing=12)
            r.set_border_width(8)
            r.pack_start(label(text), True, True, 0)
            r.pack_end(widget, False, False, 0)
            frame.add(r)

